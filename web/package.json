{
  "name": "xscs-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "test:unit": "node --test tests/*.test.mjs",
    "check:xcss": "node scripts/check-xcss-toolchain.mjs",
    "build": "npm run check:xcss && tsc -b && vite build",
    "preview": "vite preview",
    "test:browser": "npm run test:unit && npm run build && node tests/browser-acceptance.mjs && node tests/remote-controls.mjs && node tests/config-snapshot.mjs && node tests/moonlight-pairing.mjs"
  },
  "dependencies": {
    "@xcss/web": "https://github.com/isarmg/xcss/releases/download/v1.0.0/xcss-web-1.0.0.tgz",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
